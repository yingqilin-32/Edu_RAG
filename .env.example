# Copy parameters from Supabase Dashboard > Connect > Session pooler.
# Do not guess the host. Keep all credentials in this local file.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
# Quote the password. For a password containing a single quote, use double quotes.
DB_PASSWORD=''
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10

# BGE-M3 is cached locally; V1 uses the same encoder for indexing and queries.
# Model identifier is stored with each vector; different models are not mixed.
EMBEDDING_MODEL=BAAI/bge-m3

# V1 answer generation. Required only when requesting a generated answer.
# Keep the real API key in your local .env only.
DEEPSEEK_API_KEY=''
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=45

# CPU/FP32 is the verified V1 baseline; the max length forms part of the vector identity.
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_LENGTH=512

# V3 local BM25 corpus limit (after curriculum filters); never silently truncate.
BM25_MAX_DOCUMENTS=5000
